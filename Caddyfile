sing-language.duckdns.org {
    # Backend API proxy
    handle_path /api/* {
        reverse_proxy lsv-api:3000
    }

    # Frontend proxy
    reverse_proxy lsv-frontend:80

    # Enable compression
    encode zstd gzip

    # Cabeceras de seguridad: fuente única en nginx (lsv-frontend/nginx.conf) y en la
    # API (securityHeaders). Caddy no añade ninguna para no duplicarlas ni pisarlas
    # (AS-S5-01). Si hay que cambiarlas, cambiarlas solo en esas dos fuentes.
}
