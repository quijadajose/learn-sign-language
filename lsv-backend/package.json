{
  "name": "lsv-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "node dist/main",
    "typeorm": "node --env-file=.env ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run build && npm run typeorm -- migration:generate -d dist/db/data-source.js",
    "migration:run": "npm run build && npm run typeorm -- migration:run -d dist/db/data-source.js",
    "migration:revert": "npm run build && npm run typeorm -- migration:revert -d dist/db/data-source.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --env-file=../.env.test --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "test:e2e:smoke": "node --env-file=../.env.test --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand --testPathPatterns=auth.e2e-spec --testPathPatterns=health.e2e-spec --testPathPatterns=sign-record.e2e-spec --testPathPatterns=quizzes.e2e-spec --testPathPatterns=user-lesson.e2e-spec --testPathPatterns=moderators.e2e-spec --testPathPatterns=critical-flows.e2e-spec",
    "validate-infrastructure": "depcruise --config .dependency-cruiser.cjs src",
    "openapi:generate": "nest start --entryFile generate-openapi",
    "create-admin": "npm run build && node --env-file-if-exists=.env dist/cli/create-admin.js",
    "startProd": "node dist/main.js"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^12.0.1",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/microservices": "^12.4.0",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/platform-socket.io": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.3",
    "@nestjs/websockets": "^12.4.0",
    "@sentry/nestjs": "^11.11.0",
    "@sentry/profiling-node": "^11.11.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "file-type": "^22.0.1",
    "ioredis": "^6.0.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/main.ts",
      "!**/instrument.ts"
    ],
    "coverageProvider": "v8",
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 10,
        "branches": 10,
        "functions": 5,
        "lines": 10
      }
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@nestjs/throttler$": "<rootDir>/../test/__mocks__/nestjs-throttler.mjs",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!@nestjs/)"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "setupFiles": [
      "<rootDir>/../test/jest-setup.ts"
    ]
  },
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf",
  "overrides": {
    "ajv": "^8.18.0",
    "eslint": {
      "ajv": "^6.14.0"
    },
    "minimatch": "^11.0.1",
    "file-type": "^22.0.1",
    "diff": "^5.2.0",
    "ioredis": "$ioredis",
    "@nest-lab/throttler-storage-redis": {
      "@nestjs/common": "$@nestjs/common",
      "@nestjs/core": "$@nestjs/core",
      "@nestjs/throttler": "$@nestjs/throttler"
    }
  },
  "type": "module"
}
