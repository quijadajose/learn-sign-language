# NODE_ENV: development | production | test
NODE_ENV=development

# ------------------------------------------
# FRONTEND CONFIG
# ------------------------------------------
# URL where the frontend is accessible
FRONTEND_URL=http://localhost:8080
# Browser-facing API base (leave unset in Docker/prod to use /api via Caddy)
# VITE_API_URL=http://localhost:3000
# Vite dev proxy target (host or compose service)
# VITE_API_PROXY_TARGET=http://localhost:3000
# HMR websocket port when accessing Vite through a reverse proxy
# VITE_HMR_CLIENT_PORT=8080

# ------------------------------------------
# SENTRY CONFIG
# ------------------------------------------
# Backend DSN
SENTRY_DSN='https://domain@user.ingest.region.sentry.io/id_backend'
# Frontend DSN (Must start with VITE_)
VITE_SENTRY_DSN='https://domain@user.ingest.region.sentry.io/id_frontend'

# ------------------------------------------
# API / BACKEND CONFIG
# ------------------------------------------
API_PORT=3000
# REQUIRED: use a long random string in any non-local environment
JWT_SECRET=change-me-to-a-long-random-secret
# HMAC between API and model trainer (falls back to JWT_SECRET if unset)
# TRAINER_JOB_SECRET=change-me-to-a-distinct-trainer-hmac-secret
# JWT_EXPIRES_IN=1d

# Shared volume for training data / models (API view vs trainer worker view).
# In Docker Compose these map to the same named volume via different mount points.
# SHARED_DATA_DIR=/src/app/shared
# WORKER_SHARED_DATA_DIR=/shared
# Trainer reads DATA_BASE_DIR=/shared (see lsv-model-trainer).

# Admin & Test User Seed Data (change before production)
API_ADMIN_EMAIL=admin@example.com
API_ADMIN_PASSWORD=change-me-admin-password
API_USER_EMAIL=user@example.com
API_USER_PASSWORD=change-me-user-password

# ------------------------------------------
# DATABASE CONFIG
# ------------------------------------------
# Use 'lsv-db' when running in Docker, '127.0.0.1' for local testing
DB_HOST=lsv-db
DB_PORT=5432
DB_USERNAME=lsv_user
DB_PASSWORD=change-me-db-password
DB_DATABASE=plataforma
# Set to false when migrations run as a separate job (multi-replica). Default: true.
# RUN_MIGRATIONS=false
VALKEY_HOST=lsv-valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=change-me-valkey-password

# ------------------------------------------
# OAUTH2 GOOGLE CREDENTIALS
# ------------------------------------------
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx-xxxxxxxxxxx-xxxxxxxxxxxxxx
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ------------------------------------------
# EMAIL CONFIG
# ------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER="example@gmail.com"
EMAIL_PASSWORD="xxxx xxxx xxxx xxxx"
EMAIL_SECURE=false

# ------------------------------------------
# ADMIN TOOLS CONFIG
# ------------------------------------------
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

